{
  "name": "hackathon-micro",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev:api": "npm run dev --workspace @carpool/api",
    "dev:mobile": "npm run start --workspace @carpool/mobile",
    "dev:web": "npm run web --workspace @carpool/mobile",
    "dev:android": "npm run android --workspace @carpool/mobile",
    "dev:ios": "npm run ios --workspace @carpool/mobile",
    "test": "tsx --test packages/contracts/tests/*.test.ts apps/api/tests/*.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --workspace @carpool/api",
    "build:web": "npm run export:web --workspace @carpool/mobile",
    "build:mobile": "npm run export:native --workspace @carpool/mobile",
    "db:generate": "npm run db:generate --workspace @carpool/api",
    "db:migrate": "npm run db:migrate --workspace @carpool/api",
    "db:seed": "npm run db:seed --workspace @carpool/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0"
  }
}
